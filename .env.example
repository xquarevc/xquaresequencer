# --- Core ---
PORT=3000
BASE_URL=http://localhost:3000        # public URL; used for tracking links, unsubscribe links, OAuth redirects
APP_SECRET=change-me-to-a-long-random-string   # signs sessions + encrypts mailbox credentials. REQUIRED in production.
DATA_DIR=./data
NODE_ENV=development
# live = really send via SMTP; dry = record sends without touching the network (demo/dev)
SEND_MODE=dry

# --- Google OAuth (user login + Gmail mailbox connect) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# --- Microsoft OAuth (Outlook/365 mailbox connect + login) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Payments (Stripe Checkout). Leave empty to use the sandbox provider in dev. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SANDBOX=true                  # allow instant fake top-ups when Stripe isn't configured (never enable in prod)

# --- Pricing (USD micros: 1,000,000 = $1) ---
PRICE_PER_EMAIL_MICROS=2000
PRICE_PER_BLACKLIST_CHECK_MICROS=10000
SIGNUP_BONUS_MICROS=1000000

# --- Optional registrar integration (availability/pricing) ---
GODADDY_KEY=
GODADDY_SECRET=
GODADDY_API=https://api.godaddy.com
